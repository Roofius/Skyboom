
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>SkyBoom 3D</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    html, body {
      margin: 0;
      padding: 0;
      overflow: hidden;
      background: #87ceeb;
    }
    canvas {
      display: block;
    }
    #ui {
      position: absolute;
      top: 10px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 2;
    }
    button {
      padding: 10px 16px;
      margin: 0 5px;
      font-size: 16px;
      border: none;
      border-radius: 6px;
      background: #ff5722;
      color: white;
      cursor: pointer;
    }
  </style>
</head>
<body>
<div id="ui">
  <button id="startBtn">Старт</button>
  <button id="dropBtn" disabled>Сбросить</button>
</div>

<script src="https://cdn.jsdelivr.net/npm/three@0.153.0/build/three.min.js"></script>
<script>
  let scene, camera, renderer;
  let plane, cargo;
  let animationFrame;
  let velocity = 0.5;
  let flying = false;
  let detached = false;

  init();
  function init() {
    scene = new THREE.Scene();
    camera = new THREE.PerspectiveCamera(70, window.innerWidth/window.innerHeight, 0.1, 1000);
    camera.position.set(0, 5, 20);
    camera.lookAt(0, 0, 0);

    renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    document.body.appendChild(renderer.domElement);

    // Свет
    const light = new THREE.DirectionalLight(0xffffff, 1);
    light.position.set(5, 10, 7.5);
    scene.add(light);

    // Взлётная полоса
    const groundGeo = new THREE.PlaneGeometry(50, 10);
    const groundMat = new THREE.MeshPhongMaterial({ color: 0x333333 });
    const ground = new THREE.Mesh(groundGeo, groundMat);
    ground.rotation.x = -Math.PI / 2;
    ground.position.y = 0;
    scene.add(ground);

    // Самолёт
    const planeGeo = new THREE.BoxGeometry(2.5, 1, 1);
    const planeMat = new THREE.MeshPhongMaterial({ color: 0x2196f3 });
    plane = new THREE.Mesh(planeGeo, planeMat);
    plane.position.set(-20, 1, 0);
    scene.add(plane);

    // Груз
    const cargoGeo = new THREE.BoxGeometry(1, 1, 1);
    const cargoMat = new THREE.MeshPhongMaterial({ color: 0x8d6e63 });
    cargo = new THREE.Mesh(cargoGeo, cargoMat);
    cargo.position.set(-20, 0.5, -1.2);
    scene.add(cargo);

    animate();
  }

  function animate() {
    animationFrame = requestAnimationFrame(animate);

    if (flying) {
      plane.position.x += velocity;
      if (!detached) {
        cargo.position.x += velocity;
      }

      if (plane.position.x > -10) {
        plane.position.y += 0.05;
        if (!detached) cargo.position.y += 0.05;
      }

      if (plane.position.x > 15) {
        flying = false;
        cancelAnimationFrame(animationFrame);
        if (!detached) {
          alert("Краш! Груз не сброшен!");
        }
      }
    }

    renderer.render(scene, camera);
  }

  document.getElementById("startBtn").onclick = () => {
    flying = true;
    detached = false;
    document.getElementById("dropBtn").disabled = false;
  };

  document.getElementById("dropBtn").onclick = () => {
    detached = true;
    document.getElementById("dropBtn").disabled = true;
    alert("Груз сброшен! Успех!");
  };
</script>
</body>
</html>
